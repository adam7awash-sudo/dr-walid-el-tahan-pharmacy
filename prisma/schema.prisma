generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Category {
  id        String    @id @default(cuid())
  slug      String    @unique
  nameEn    String
  nameAr    String
  icon      String    @default("pill")
  color     String    @default("#0e7490")
  isSpecial Boolean   @default(false)
  sortOrder Int       @default(0)
  products  Product[]
}

model Brand {
  id       String    @id @default(cuid())
  slug     String    @unique
  nameEn   String
  nameAr   String
  color    String    @default("#0e7490")
  products Product[]
}

model Product {
  id           String    @id @default(cuid())
  slug         String    @unique
  nameEn       String
  nameAr       String
  descEn       String    @default("")
  descAr       String    @default("")
  price        Float
  comparePrice Float?
  image        String
  rating       Float     @default(4.5)
  reviews      Int       @default(0)
  stock        Int       @default(50)
  skinType     String?
  isFeatured   Boolean   @default(false)
  isOnSale     Boolean   @default(false)
  sellCount    Int       @default(0)
  categoryId   String
  category     Category  @relation(fields: [categoryId], references: [id])
  brandId      String
  brand        Brand     @relation(fields: [brandId], references: [id])
  createdAt    DateTime  @default(now())
  orderItems   OrderItem[]
}

model PromoCode {
  id       String  @id @default(cuid())
  code     String  @unique
  type     String // percent | fixed | freeship
  value    Float
  minTotal Float   @default(0)
  active   Boolean @default(true)
}

model Order {
  id            String      @id @default(cuid())
  orderNumber   String      @unique
  customerName  String
  phone         String
  email         String?
  governorate   String
  city          String
  address       String
  notes         String?
  shippingMethod String // sameday | saver | standard
  paymentMethod String // cod | card
  subtotal      Float
  autoDiscount  Float       @default(0)
  promoDiscount Float       @default(0)
  promoCode     String?
  shippingFee   Float
  total         Float
  status        String      @default("pending")
  createdAt     DateTime    @default(now())
  items         OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  nameEn    String
  nameAr    String
  price     Float
  quantity  Int
}
